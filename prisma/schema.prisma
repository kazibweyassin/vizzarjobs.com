generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  website            String?
  logo               String?
  size               String?
  industry           String?
  location           String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationDate   DateTime?
  verificationNotes  String?
  verified           Boolean            @default(false)
  reputation         Int                @default(0)
  premium            Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employees          Employee[]
  jobs               Job[]
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String?
  companyId       String
  location        String? // City in Canada
  skills          String[]         @default([]) // Tech-specific skills
  remote          Boolean          @default(false)
  visaSponsorship Boolean          @default(true) // Always true for Canada focus
  featured        Boolean          @default(false)
  premium         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  country         String           @default("Canada") // Fixed to Canada
  techStack       String[]         @default([]) // Tech stack
  requirements    String[]         @default([])
  applicationUrl  String?
  jobType         JobType?
  salaryMax       Int?
  salaryMin       Int?
  experienceLevel ExperienceLevel?
  embedding       JobEmbedding?
  jobMatches      JobMatch[]

  // Tech-specific fields (AI/ML focus kept for backward compatibility)
  aiMlFocus      AIMLFocus     @default(MACHINE_LEARNING)
  skillLevel     SkillLevel    @default(MID)
  certifications String[]      @default([]) // Tech certifications
  projects       String[]      @default([]) // Required project types
  applications   Application[]
  company        Company       @relation(fields: [companyId], references: [id], map: "companyRelation")

  @@index([companyId])
  @@index([aiMlFocus])
  @@index([skillLevel])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                   String             @id @default(cuid())
  name                 String?
  email                String?            @unique
  emailVerified        DateTime?
  image                String?
  role                 UserRole           @default(USER)
  bio                  String?
  location             String?
  resume               String?
  website              String?
  githubUrl            String?
  linkedinUrl          String?
  skills               String[] // Tech-focused skills
  verificationStatus   VerificationStatus @default(PENDING)
  verified             Boolean            @default(false)
  premium              Boolean            @default(false)
  premiumTier          String?
  reputation           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  profileComplete      Boolean            @default(false)
  failedLoginAttempts  Int                @default(0)
  lockedUntil          DateTime?
  password             String?
  passwordResetExpires DateTime?
  passwordResetToken   String?
  cvUploads            CVUpload[]

  // Tech-specific fields
  aiMlFocus           AIMLFocus? // Primary tech specialization (kept for backward compatibility)
  skillLevel          SkillLevel? // Skill level assessment
  certifications      String[]             @default([]) // Tech certifications
  portfolioUrl        String? // Tech portfolio
  projects            String[]             @default([]) // Tech projects
  publications        String[]             @default([]) // Research publications
  accounts            Account[]
  applications        Application[]
  employee            Employee?
  jobSeekerProfile    JobSeekerProfile?
  matchingPreferences MatchingPreferences?
  sessions            Session[]
  subscriptions       Subscription[]

  @@index([email])
  @@index([aiMlFocus])
  @@index([skillLevel])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactRequest {
  id                       String               @id @default(cuid())
  companyName              String
  contactName              String
  contactEmail             String
  contactPhone             String?
  website                  String?
  industry                 String
  companySize              String
  location                 String
  description              String
  visaSponsorshipConfirmed Boolean              @default(false)
  requestType              ContactRequestType   @default(ADD_COMPANY)
  status                   ContactRequestStatus @default(PENDING)
  adminNotes               String?
  createdAt                DateTime             @default(now())
  reviewedAt               DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String
  employeeId String
  uploadedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  employeeId  String
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  interests String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model MatchingPreferences {
  id                    String      @id @default(cuid())
  userId                String      @unique
  jobRoles              String[] // Tech roles
  skills                String[] // Tech skills
  industries            String[]    @default(["Technology", "Software", "IT"])
  locations             String[]    @default(["Canada"]) // Focus on Canada
  remotePreference      Boolean     @default(false)
  salaryMin             Int?
  salaryMax             Int?
  experienceLevels      String[]
  employmentTypes       String[]
  visaSponsorshipNeeded Boolean     @default(true) // Always true for Canada
  relocationWillingness Boolean     @default(true)
  // Tech-specific preferences
  aiMlFocus             AIMLFocus[] @default([]) // Preferred tech specializations (kept for backward compatibility)
  skillLevel            SkillLevel? // Preferred skill level
  certifications        String[]    @default([]) // Preferred certifications
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aiMlFocus])
}

model Employee {
  id               String           @id @default(cuid())
  userId           String           @unique
  companyId        String
  position         String
  department       String?
  startDate        DateTime
  employmentType   EmploymentType   @default(FULL_TIME)
  salary           Int?
  manager          String?
  emergencyContact String?
  emergencyPhone   String?
  onboardingStatus OnboardingStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documents        Document[]
  company          Company          @relation(fields: [companyId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingSteps  OnboardingStep[]

  @@index([userId])
  @@index([companyId])
}

model JobSeekerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  title           String
  bio             String? @db.Text
  phoneNumber     String?
  currentJobTitle String?

  // Skills and experience
  skills            String?  @db.Text
  technicalSkills   String[]
  languages         String[]
  yearsOfExperience String?

  // Career preferences
  preferredJobTypes       String[]
  locationPreferences     String[]
  desiredSalary           String
  salaryCurrency          String?   @default("USD")
  location                String
  willingToRelocate       Boolean   @default(false)
  remotePreference        String?
  visaSponsorshipRequired Boolean   @default(false)
  availabilityDate        DateTime?

  // Education and experience
  education               Json[]
  workExperience          Json[]
  certifications          Json[]
  projectsAndPublications Json[]

  // Online presence
  linkedInProfile String?
  portfolioUrl    String?
  githubUrl       String?
  twitterUrl      String?
  personalWebsite String?

  // System fields
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  planName           String
  price              Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  status             SubscriptionStatus @default(ACTIVE)
  billingCycle       BillingCycle       @default(MONTHLY)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  nextBillingDate    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  externalCustomerId String?
  externalId         String?
  paymentMethod      PaymentMethod      @default(CARD)
  paymentProvider    PaymentProvider    @default(FLUTTERWAVE)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum JobType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
  PART_TIME
  FREELANCE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum UserRole {
  USER
  JOB_SEEKER
  EMPLOYER
  ADMIN
  EMPLOYEE
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum ContactRequestType {
  ADD_COMPANY
  GENERAL_INQUIRY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
  PENDING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  PAYPAL
  WALLET
}

enum PaymentProvider {
  FLUTTERWAVE
  PAYPAL
  MTN_MOBILE_MONEY
  AIRTEL_MONEY
  PAYSTACK
  MANUAL
}

model CandidatePool {
  id                   String          @id @default(cuid())
  fullName             String
  email                String          @unique
  phoneNumber          String?
  country              String
  profession           String // Tech-focused profession
  skills               String[]        @default([]) // Tech-specific skills
  yearsOfExperience    Int
  educationLevel       EducationLevel
  preferredDestination String[]        @default(["Canada"]) // Default to Canada
  needsVisaSponsorship Boolean         @default(true) // Default true for Canada
  cvFilePath           String?
  cvPublicId           String? // Cloudinary public ID
  cvSecureUrl          String? // Cloudinary secure URL
  jobAlerts            Boolean         @default(true)
  status               CandidateStatus @default(ACTIVE)
  notes                String?
  contactedAt          DateTime?
  contactedBy          String?
  // Tech-specific fields
  aiMlFocus            AIMLFocus       @default(MACHINE_LEARNING) // Tech specialization (kept for backward compatibility)
  skillLevel           SkillLevel      @default(MID)
  certifications       String[]        @default([]) // Tech certifications
  githubUrl            String? // GitHub portfolio
  portfolioUrl         String? // Personal portfolio
  projects             String[]        @default([]) // Tech projects
  publications         String[]        @default([]) // Research publications
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([aiMlFocus])
  @@index([skillLevel])
  @@map("candidate_pool")
}

enum CandidateStatus {
  ACTIVE
  CONTACTED
  PLACED
  INACTIVE
}

enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATION
  OTHER
}

enum AIMLFocus {
  MACHINE_LEARNING
  DEEP_LEARNING
  NATURAL_LANGUAGE_PROCESSING
  COMPUTER_VISION
  DATA_SCIENCE
  AI_RESEARCH
  ML_ENGINEERING
  AI_PRODUCT_MANAGEMENT
  ROBOTICS
  AUTONOMOUS_SYSTEMS
}

// ============================================
// AI JOB MATCHING SYSTEM
// ============================================

// Stores uploaded CV files and processing status
model CVUpload {
  id       String @id @default(cuid())
  userId   String // Who uploaded it
  fileName String // Original filename
  fileUrl  String // Storage URL (Cloudinary/S3)
  fileSize Int // File size in bytes
  mimeType String // PDF, DOC, etc.

  // Processing status
  status          CVProcessStatus @default(PENDING)
  processingError String? // Error message if failed

  // Extracted data
  extractedText   String?  @db.Text // Full CV text
  extractedSkills String[] @default([]) // AI-extracted skills

  // Timestamps
  uploadedAt  DateTime  @default(now())
  processedAt DateTime? // When AI processing completed

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillEmbeddings SkillEmbedding[]
  jobMatches      JobMatch[]

  @@index([userId])
  @@index([status])
  @@map("cv_uploads")
}

// Stores vector embeddings for skills extracted from CVs
model SkillEmbedding {
  id         String   @id @default(cuid())
  cvUploadId String // Which CV this skill came from
  skillText  String // e.g., "React", "Machine Learning"
  embedding  String // JSON string of vector [0.1, 0.2, ...]
  confidence Float    @default(1.0) // AI confidence (0-1)
  createdAt  DateTime @default(now())

  cvUpload CVUpload @relation(fields: [cvUploadId], references: [id], onDelete: Cascade)

  @@index([cvUploadId])
  @@map("skill_embeddings")
}

// Pre-computed embeddings for jobs (for fast matching)
model JobEmbedding {
  id               String @id @default(cuid())
  jobId            String @unique // Links to Job model
  descriptionEmbed String // Embedding of job description
  skillsEmbed      String // Embedding of required skills
  combinedEmbed    String // Combined embedding for overall match

  lastUpdated DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_embeddings")
}

// Stores match results between CVs and jobs
model JobMatch {
  id         String @id @default(cuid())
  cvUploadId String // Which CV
  jobId      String // Which job

  // Match scoring
  matchScore      Float // 0-100 percentage
  skillsScore     Float // How well skills match
  experienceScore Float // How well experience matches

  // AI explanation
  matchReason   String   @db.Text // Why this job matches
  missingSkills String[] @default([]) // What skills are missing

  // Status
  viewed  Boolean @default(false) // Has user seen this match?
  applied Boolean @default(false) // Has user applied?

  createdAt DateTime @default(now())

  // Relations
  cvUpload CVUpload @relation(fields: [cvUploadId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([cvUploadId, jobId]) // One match per CV-Job pair
  @@index([cvUploadId])
  @@index([jobId])
  @@index([matchScore])
  @@map("job_matches")
}

// Processing status enum
enum CVProcessStatus {
  PENDING // Just uploaded, not processed yet
  PROCESSING // AI is extracting skills
  COMPLETED // Successfully processed
  FAILED // Processing failed
}

enum SkillLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  EXPERT
}
