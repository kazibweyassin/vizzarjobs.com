generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  website            String?
  logo               String?
  size               String?
  industry           String?
  location           String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationDate   DateTime?
  verificationNotes  String?
  verified           Boolean            @default(false)
  reputation         Int                @default(0)
  premium            Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  employees          Employee[]
  jobs               Job[]
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String?
  companyId       String
  location        String?
  skills          String[]         @default([])
  remote          Boolean          @default(false)
  visaSponsorship Boolean          @default(true)
  featured        Boolean          @default(false)
  premium         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  country         String?
  techStack       String[]         @default([])
  requirements    String[]         @default([])
  applicationUrl  String?
  jobType         JobType?
  salaryMax       Int?
  salaryMin       Int?
  experienceLevel ExperienceLevel?
  applications    Application[]
  company         Company          @relation(fields: [companyId], references: [id], map: "companyRelation")

  @@index([companyId])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?
  image                String?
  role                 UserRole             @default(USER)
  bio                  String?
  location             String?
  resume               String?
  website              String?
  githubUrl            String?
  linkedinUrl          String?
  skills               String[]
  verificationStatus   VerificationStatus   @default(PENDING)
  verified             Boolean              @default(false)
  premium              Boolean              @default(false)
  premiumTier          String?
  reputation           Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  profileComplete      Boolean              @default(false)
  failedLoginAttempts  Int                  @default(0)
  lockedUntil          DateTime?
  password             String?
  passwordResetExpires DateTime?
  passwordResetToken   String?
  accounts             Account[]
  applications         Application[]
  employee             Employee?
  jobSeekerProfile     JobSeekerProfile?
  matchingPreferences  MatchingPreferences?
  sessions             Session[]
  subscriptions        Subscription[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactRequest {
  id                       String               @id @default(cuid())
  companyName              String
  contactName              String
  contactEmail             String
  contactPhone             String?
  website                  String?
  industry                 String
  companySize              String
  location                 String
  description              String
  visaSponsorshipConfirmed Boolean              @default(false)
  requestType              ContactRequestType   @default(ADD_COMPANY)
  status                   ContactRequestStatus @default(PENDING)
  adminNotes               String?
  createdAt                DateTime             @default(now())
  reviewedAt               DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String
  employeeId String
  uploadedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  employeeId  String
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  interests String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model MatchingPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  jobRoles              String[]
  skills                String[]
  industries            String[]
  locations             String[]
  remotePreference      Boolean  @default(false)
  salaryMin             Int?
  salaryMax             Int?
  experienceLevels      String[]
  employmentTypes       String[]
  visaSponsorshipNeeded Boolean  @default(true)
  relocationWillingness Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Employee {
  id               String           @id @default(cuid())
  userId           String           @unique
  companyId        String
  position         String
  department       String?
  startDate        DateTime
  employmentType   EmploymentType   @default(FULL_TIME)
  salary           Int?
  manager          String?
  emergencyContact String?
  emergencyPhone   String?
  onboardingStatus OnboardingStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documents        Document[]
  company          Company          @relation(fields: [companyId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingSteps  OnboardingStep[]

  @@index([userId])
  @@index([companyId])
}

model JobSeekerProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  title                   String
  skills                  String
  preferredJobTypes       String[]
  desiredSalary           String
  location                String
  willingToRelocate       Boolean  @default(false)
  visaSponsorshipRequired Boolean  @default(false)
  linkedInProfile         String?
  portfolioUrl            String?
  resumeUrl               String?
  lastUpdated             DateTime @default(now())
  createdAt               DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  planName           String
  price              Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  status             SubscriptionStatus @default(ACTIVE)
  billingCycle       BillingCycle       @default(MONTHLY)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  nextBillingDate    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  externalCustomerId String?
  externalId         String?
  paymentMethod      PaymentMethod      @default(CARD)
  paymentProvider    PaymentProvider    @default(FLUTTERWAVE)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum JobType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
  PART_TIME
  FREELANCE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum UserRole {
  USER
  JOB_SEEKER
  EMPLOYER
  ADMIN
  EMPLOYEE
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum ContactRequestType {
  ADD_COMPANY
  GENERAL_INQUIRY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
  PENDING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  PAYPAL
  WALLET
}

enum PaymentProvider {
  FLUTTERWAVE
  PAYPAL
  MTN_MOBILE_MONEY
  AIRTEL_MONEY
  PAYSTACK
  MANUAL
}
