generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String              @id @default(cuid())
  name              String
  description       String?
  website           String?
  logo              String?
  size              String?
  industry          String?
  location          String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationDate  DateTime?
  verificationNotes String?
  verified          Boolean             @default(false)
  reputation        Int                 @default(0)
  premium           Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  jobs              Job[]
  employees         Employee[]
}

model Job {
  id              String         @id @default(cuid())
  title           String
  description     String?
  company         Company        @relation(fields: [companyId], references: [id], map: "companyRelation")
  companyId       String
  location        String?
  country         String?
  jobType         JobType?
  experienceLevel ExperienceLevel?
  salaryMin       Int?
  salaryMax       Int?
  applicationUrl  String?
  requirements    String[]       @default([])
  skills          String[]       @default([])
  techStack       String[]       @default([])
  remote          Boolean        @default(false)
  visaSponsorship Boolean        @default(true)
  featured        Boolean        @default(false)
  premium         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  applications    Application[]
  
  @@index([companyId])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole            @default(USER)
  bio                String?
  location           String?
  resume             String?
  website            String?
  githubUrl          String?
  linkedinUrl        String?
  skills             String[]
  verificationStatus VerificationStatus  @default(PENDING)
  verified           Boolean             @default(false)
  premium            Boolean             @default(false)
  premiumTier        String?
  reputation         Int                 @default(0)
  profileComplete     Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  applications       Application[]
  matchingPreferences MatchingPreferences?
  employee           Employee?
  jobSeekerProfile   JobSeekerProfile?
  
  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactRequest {
  id                       String               @id @default(cuid())
  companyName              String
  contactName              String
  contactEmail             String
  contactPhone             String?
  website                  String?
  industry                 String
  companySize              String
  location                 String
  description              String
  visaSponsorshipConfirmed Boolean              @default(false)
  requestType              ContactRequestType   @default(ADD_COMPANY)
  status                   ContactRequestStatus @default(PENDING)
  adminNotes               String?
  createdAt                DateTime             @default(now())
  reviewedAt               DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

enum JobType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

enum UserRole {
  USER
  JOB_SEEKER
  EMPLOYER
  EMPLOYEE
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  REJECTED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEED_MORE_INFO
}

enum ContactRequestType {
  ADD_COMPANY
  GENERAL_INQUIRY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model Document {
  id          String    @id @default(cuid())
  name        String
  type        String
  url         String
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedAt  DateTime  @default(now())
  
  @@index([employeeId])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([employeeId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  interests String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model MatchingPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRoles              String[]
  skills                String[]
  industries            String[]
  locations             String[]
  remotePreference      Boolean  @default(false)
  salaryMin             Int?
  salaryMax             Int?
  experienceLevels      String[]
  employmentTypes       String[]
  visaSponsorshipNeeded Boolean  @default(true)
  relocationWillingness Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
}

model Employee {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  position          String
  department        String?
  startDate         DateTime
  employmentType    EmploymentType @default(FULL_TIME)
  salary            Int?
  manager           String?
  emergencyContact  String?
  emergencyPhone    String?
  documents         Document[]
  onboardingStatus  OnboardingStatus @default(PENDING)
  onboardingSteps   OnboardingStep[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([userId])
  @@index([companyId])
}

model JobSeekerProfile {
  id                      String        @id @default(cuid())
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String        @unique
  title                   String
  skills                  String
  preferredJobTypes       String[]
  desiredSalary           String
  location                String
  willingToRelocate       Boolean       @default(false)
  visaSponsorshipRequired Boolean       @default(false)
  linkedInProfile         String?
  portfolioUrl            String?
  resumeUrl               String?
  lastUpdated             DateTime      @default(now())
  createdAt               DateTime      @default(now())

  @@index([userId])
}
